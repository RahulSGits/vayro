# ============================================================================
# VAYRO — environment
# Copy to `.env.local`. Every integration is optional: with none of these set
# the storefront runs in demo mode against the seed catalogue.
# ============================================================================

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# --- Supabase (database, auth, storage) ------------------------------------
# Project settings -> API. The anon key is public by design; the service role
# key is NOT and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Social sign-in. Supabase does not publish its enabled provider list, so the
# storefront is told explicitly. Enable the provider in Supabase -> Authentication
# -> Providers first; anything not listed here renders as a disabled button with
# the reason attached rather than a control that fails on click.
# Supported: google, apple
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Demo accounts created by `npm run seed` --------------------------------
# Development credentials only. Change these before any deployment.
SEED_ADMIN_EMAIL=admin@vayro-demo.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_2026!
SEED_CUSTOMER_EMAIL=customer@vayro-demo.local
SEED_CUSTOMER_PASSWORD=ChangeMe_User_2026!

# --- Stripe (payments) ------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Razorpay (payments, India) ---------------------------------------------
# The second payment rail. Independent of Stripe: both can be configured at
# once, and `/api/checkout/razorpay` works whether or not Razorpay is the
# default. Dashboard -> Account & Settings -> API Keys.
#
# The key id is publishable — it is what Checkout.js is initialised with in the
# browser — but it is NOT prefixed with NEXT_PUBLIC_, because the checkout
# route hands it out with the order it belongs to rather than baking it into
# every bundle. Test keys start `rzp_test_`, live keys `rzp_live_`.
RAZORPAY_KEY_ID=
# Secret. Signs the client's return signature (order_id|payment_id) and
# authenticates order creation. Shown once, at key generation.
RAZORPAY_KEY_SECRET=
# Secret. Set when creating the webhook in Dashboard -> Settings -> Webhooks;
# it is chosen by you, not issued. Without it `/api/webhooks/razorpay` refuses
# every request — signature verification is never optional.
# Endpoint to register: https://<your-domain>/api/webhooks/razorpay
# Events to subscribe: payment.captured, payment.failed, order.paid,
#                      refund.created, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# --- Payment rail selection -------------------------------------------------
# Which provider the checkout offers by default: `stripe` (default) or
# `razorpay`. Naming a provider does not configure it — if its keys are absent
# the checkout says so rather than silently falling back, because a silent
# downgrade would show a payment form the environment cannot honour.
PAYMENT_PROVIDER=stripe

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=
RESEND_FROM="VAYRO <hello@vayro.example>"

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GA_ID=

# --- Monitoring (Sentry-ready) ----------------------------------------------
SENTRY_DSN=
